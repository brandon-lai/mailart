{
  "name": "mailart",
  "private": true,
  "packageManager": "pnpm@9.15.2",
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter @mailart/render-worker dev",
    "build": "pnpm --filter web build",
    "worker": "pnpm --filter @mailart/render-worker start",
    "db:generate": "pnpm --filter @mailart/db generate",
    "db:migrate": "pnpm --filter @mailart/db migrate",
    "assets:fetch": "tsx scripts/assets/fetch.ts",
    "assets:sheets": "tsx scripts/assets/sheets.ts",
    "assets:cutout": ".venv/bin/python scripts/assets/process.py",
    "assets:manifest": "tsx scripts/assets/manifest.ts",
    "typecheck": "tsc -p packages/envelope && tsc -p packages/db && tsc -p packages/emails && tsc -p workers/render && tsc -p apps/web",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "opentype.js": "1.3.4",
    "postgres": "3.4.9",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "1.2.12"
  },
  "engines": {
    "node": ">=22.9"
  }
}
