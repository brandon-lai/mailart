# Postgres. Unset = demo mode: pages and previews work, every write refuses with a 503.
DATABASE_URL=

# Rendered GIF/PNG storage (S3-compatible: MinIO locally, R2/S3/Supabase Storage later).
# Unset = files go to ./storage and the web app serves them at /files/...
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
PUBLIC_FILES_BASE_URL=          # public URL prefix for the bucket, if different from S3_ENDPOINT/S3_BUCKET

# Library images for anything that leaves the site. Defaults to ${SITE_URL}/lib/
PUBLIC_ASSET_BASE_URL=

EMAIL_PROVIDER=mailpit          # mailpit | resend | postmark
EMAIL_API_KEY=
SENDING_DOMAIN=                 # letters@<this>; use a dedicated subdomain with SPF, DKIM and DMARC
MAILPIT_HOST=localhost
MAILPIT_PORT=1025

SITE_NAME=Mailart
SITE_URL=http://localhost:3335
RENDER_BASE_URL=                # where the worker loads /render/:id from; defaults to SITE_URL

WORKER_SECRET=                  # shared by the web app (/render/:id) and the worker; openssl rand -hex 32
HASH_SECRET=                    # keys the email/IP hashes and opt-out tokens; never rotate once in use

MODERATION_API_KEY=             # an Anthropic API key; unset = local word list only
SMITHSONIAN_API_KEY=            # api.data.gov, only for the asset scripts (not used yet)

ENABLE_DEV_GALLERY=             # 1 = serve /dev/gallery in production
